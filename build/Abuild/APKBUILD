# Maintainer: Leo Shen <yishen@qnx.com>
pkgname=nghttp2
pkgver=1.65.0
pkgrel=1
pkgdesc="HTTP/2 C Library"
url="https://nghttp2.org"
arch="all"
license="MIT"
makedepends="qnx-io-sock-dev"
subpackages="$pkgname-static $pkgname-doc $pkgname-dev"
source="https://github.com/nghttp2/nghttp2/releases/download/v$pkgver/nghttp2-$pkgver.tar.xz"
builddir="$srcdir/nghttp2-$pkgver"

build() {
    ./configure \
        --build="$CBUILD" \
        --host="$CHOST" \
        --prefix=/usr \
        --disable-examples \
        --disable-python-bindings \
        --enable-lib-only
    make
}

package() {
    make DESTDIR="$pkgdir" install
}
sha512sums="
